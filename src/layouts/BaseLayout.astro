---
import "../styles/global.css";
import ToastContainer from "../ui/toast/ToastContainer.astro";
import { SERVER } from '../config/server';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta 
      name="description" 
      content={`${SERVER.name} - Servidor de Minecraft Bedrock. Juega ${SERVER.games.join(", ")} y más...`} 
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <ToastContainer />

    <script>
      import { bindCopy } from "../ui/clipboard/bindCopy";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bindCopy);
      } else {
        bindCopy();
      }
    </script>
  </body>
</html>
