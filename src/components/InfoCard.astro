---
interface Props {
  title: string;
  description: string;
  action: string;
  href?: string;
}

const { title, description, action, href, ...attrs } = Astro.props;

const isLink = Boolean(href);
const isExternal = !!href && /^https?:\/\//.test(href);
---

{isLink ? (
  <a
    href={href}
    class="card"
    {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    {...attrs}
  >
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="action-text">{action}</span>
  </a>
) : (
  <div
    class="card card-disabled"
    aria-disabled="true"
    {...attrs}
  >
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="action-text">{action}</span>
  </div>
)}

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 2rem;
    text-align: center;
    border-radius: 8px;
    transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
    cursor: pointer;
  }

  .card:hover {
    transform: translateY(-5px);
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--ender-purple);
  }

  h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    min-height: 60px;
    line-height: 1.5;
  }

  .action-text {
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: bold;
    color: var(--text-main);
    letter-spacing: 1px;
  }
</style>
