---
import { SERVER } from '../config/server';
---
<nav class="navbar">
  <div class="container nav-content">
    <div class="nav-left">
      <a toast-message="¡Por implementar!" toast-type="error" class="nav-link">Tienda</a>
      <a toast-message="¡Por implementar!" toast-type="error" class="nav-link">Votar</a>
    </div>
    
    <div class="nav-center"></div>

    <div class="nav-right">
      <a href={`${SERVER.discord}`} class="nav-link" target="_blank" rel="noopener noreferrer">Discord</a>
      <a toast-message="¡Por implementar!" toast-type="error" class="nav-link">Soporte</a>
    </div>
  </div>
</nav>

<style>
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--navbar-height, 80px);
    z-index: 1000;
    display: flex;
    align-items: center;

    background-color: rgba(10, 10, 10, 0); 
    backdrop-filter: blur(0px);
    box-shadow: 0 0 0 rgba(170, 0, 170, 0);

    border-bottom: none; 

    animation: stickyNav linear both;
    animation-timeline: scroll(root);
    animation-range: 0 100px;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-link {
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
    cursor: pointer;
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 480px) {
    .nav-link {
      margin: 0 8px; 
      font-size: 0.85rem;
    }
    
    .nav-content {
      padding: 0 10px;
    }
  }

  @keyframes stickyNav {
    from {
      background-color: rgba(10, 10, 10, 0);
      backdrop-filter: blur(0px);
      height: var(--navbar-height, 80px);
      box-shadow: 0 0 0 rgba(170, 0, 170, 0);
    }
    to {
      background-color: rgba(10, 10, 10, 0.9);
      backdrop-filter: blur(12px);
      height: 65px;

      box-shadow: 0 10px 30px -10px rgba(170, 0, 170, 0.6), 
                  0 4px 15px rgba(170, 0, 170, 0.3);
    }
  }
</style>
